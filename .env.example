# ── RouteMind 环境变量示例 ──────────────────────────────
# 复制为 .env 后按需修改。生产环境务必换 SECRET_KEY。

# 必填（生产）：用于 Flask session 签名。
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# 1 = 忘记密码的重置链接只打到服务端日志（Demo 环境推荐）
# 0 = 生产/严格模式（重置链接根本不生成）
DEMO_MODE=0

# SQLite 数据库路径
DB_PATH=routemind.db

# 首次启动时生成的合成订单数
DATA_SIZE=50000

# 是否开启后台增量数据（每分钟/每10分钟新增）
ENABLE_TICK=1
TICK_INTERVAL=600
TICK_SIZE=500

# 调试开关
FLASK_DEBUG=0

# Web 端口
PORT=5000