# ── RouteMind 环境变量示例 ──────────────────────────────
# 复制为 .env 后按需修改。生产环境务必换 SECRET_KEY。

SECRET_KEY=replace-me-with-a-long-random-string
DEMO_MODE=0
DB_PATH=routemind.db
DATA_SIZE=50000
ENABLE_TICK=1
TICK_INTERVAL=600
TICK_SIZE=500
FLASK_DEBUG=0
PORT=5000

# ── App Builder 默认 LLM（评审期间免配） ────────────────
# 首次启动时自动为 admin 账号预置此 Key
# 推荐用 Groq（免费额度慷慨、速度快）
DEFAULT_LLM_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite